{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci --no-audit --no-fund",
  "regions": ["bom1"],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
  },
  "crons": [
    {
      "path": "/api/cron/auto-enquiry",
      "schedule": "0 10 1,15 * *"
    },
    {
      "path": "/api/cron/amc",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 20 * * *"
    }
  ]
}
