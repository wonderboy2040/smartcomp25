# SmartComp Mobile — environment config
# Copy this file to .env and fill in the values.
# Expo automatically loads .env, .env.local, and .env.<NODE_ENV> files.

# The base URL of your deployed SmartComp web app (without trailing slash).
# Examples:
#   EXPO_PUBLIC_API_URL=https://smartcomp.shop
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:3000  (LAN dev)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: Bypass PIN auth on the web backend during development.
# Leave empty in production. The web app's APP_PIN env var must be set
# to a 4-8 digit value on the server for PIN auth to be active.
EXPO_PUBLIC_APP_PIN=

# Optional: Default phone number prefix to auto-fill on customer create (E.164 without +).
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=91

# Optional: Override the deep-link scheme. Must match app.json -> expo.scheme.
EXPO_PUBLIC_LINK_SCHEME=smartcomp

# Optional: EAS project ID (for OTA updates / EAS Build).
EXPO_PUBLIC_EAS_PROJECT_ID=smartcomp-mobile
