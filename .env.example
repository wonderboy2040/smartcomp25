# ============================================================
# SmartComp v12.0 — Firebase-only configuration
# Google Sheets / Apps Script has been REMOVED.
# Includes: item units, digital product keys, round-off, anti-clobber
# pending creates, stale-cache fallback.
# ============================================================

# ------------------------------------------------------------
# REQUIRED: Firebase Firestore backend (ultra fast, in-process SDK)
# ------------------------------------------------------------
# Two ways to provide Firebase credentials:
#
# Option A (recommended): base64-encoded service-account JSON.
#   Generate the JSON in Firebase console → Project settings →
#   Service accounts → Generate new private key, then run:
#     base64 service-account.json | tr -d '\n'
#   Paste the output here.
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# Option B (alternative): split fields. Private key must include
# literal "\n" escapes — Render/Vercel keep them as-is when set
# via the dashboard.
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# ============================================================
# PIN PROTECTION (4-digit access lock)
# ============================================================
# Set a 4-digit (or up to 8-digit) numeric PIN to lock the entire panel
# behind a PIN entry screen. Leave empty/blank to disable (open access).
#
# When set, every visitor must enter this PIN at /login before they can
# view the dashboard or call any API. The PIN is never stored in the
# browser cookie — only a SHA-256 hash of (PIN + salt) is stored.
APP_PIN=""

# ============================================================
# WHATSAPP CLOUD API (auto-send + auto-capture replies)
# ============================================================
# Optional. If set, "Generate Messages" will send automatically from
# your business WhatsApp number and supplier replies will be captured
# via webhook. If NOT set, falls back to wa.me manual mode.
#
# v12.4: When these are set, the WhatsApp "Share" button on Invoices /
# Quotations / Service Invoices will deliver the PDF DIRECTLY to the
# customer's WhatsApp as a document message — no manual attach needed.
# Works on BOTH mobile and desktop browsers since the upload happens
# server-side.
WA_TOKEN=""
WA_PHONE_NUMBER_ID=""
WA_BUSINESS_NUMBER=""           # e.g. 919876543210 (E.164, no +)
WA_VERIFY_TOKEN="smartcomp_wh_2026"   # any random string; same in Meta webhook config
WA_TEMPLATE_NAME="rate_enquiry"
WA_APP_SECRET=""                # HMAC secret from Meta App → WhatsApp → Configuration
# ============================================================

# ============================================================
# PDF GENERATION (WeasyPrint — HTML to PDF)
# ============================================================
# Optional. Path to the WeasyPrint binary on the server. When set, the
# PDF download / WhatsApp-share will use the SAME HTML engine as the
# on-screen preview (doc-html.ts → WeasyPrint) so the PDF matches the
# preview pixel-perfect.
#
# If NOT set, the app falls back to the old jsPDF engine (which produces
# a slightly different-looking PDF but still works).
#
# Install WeasyPrint on Render with:
#   pip install weasyprint
# Then set this env var to the path of the binary (usually /usr/local/bin/weasyprint).
WEASYPRINT_BIN="/home/z/.venv/bin/weasyprint"
# ============================================================

# ============================================================
# RAZORPAY (Online Payment Gateway)
# ============================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_BASE_URL=""          # Your app's public URL (for Razorpay callback + tracking links)
# ============================================================

# Optional: Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED="1"

# ============================================================
# GOOGLE DRIVE DAILY AUTO-BACKUP (v12.8) — OPTIONAL but recommended
# ============================================================
# When these are set, the app uploads a full JSON backup of all Firestore
# data to your Google Drive folder every day at 2:30 AM IST. Old backups
# are auto-deleted after GDRIVE_RETENTION_DAYS days (default 30).
#
# SETUP (one-time):
#   1. Go to https://console.cloud.google.com/ → create or pick a project.
#   2. APIs & Services → Library → enable "Google Drive API".
#   3. APIs & Services → Credentials → Create Credentials → Service Account.
#   4. Give it a name (e.g. "smartcomp-backup") → Create.
#   5. Open the service account → Keys tab → Add Key → JSON → download.
#   6. Open the JSON key file. Copy:
#        - `client_email`  → paste below as GDRIVE_CLIENT_EMAIL
#        - `private_key`   → paste below as GDRIVE_PRIVATE_KEY (keep the \n escapes!)
#   7. Go to https://drive.google.com → create a folder named "SmartComp Backups".
#      Copy the folder ID from the URL (the long string after /folders/).
#      Paste below as GDRIVE_FOLDER_ID.
#   8. Share the folder with the service account's email (Editor access).
#
# Without these env vars, the daily cron still runs but skips the Drive
# upload — backup is exported (visible in the response) but not persisted.
GDRIVE_CLIENT_EMAIL=""
GDRIVE_PRIVATE_KEY=""
GDRIVE_FOLDER_ID=""
GDRIVE_RETENTION_DAYS="30"

# ============================================================
# CRON SECRETS (auto-enquiry + AMC alerts)
# ============================================================
# On Vercel: Vercel auto-injects Authorization: Bearer ${VERCEL_CRON_SECRET}
#   when cron hits the path. Set VERCEL_CRON_SECRET in Vercel project settings.
# On Render / other hosts: set CRON_SECRET and add the header manually:
#   curl -X POST https://your-app.com/api/cron/auto-enquiry \
#        -H "Authorization: Bearer YOUR_SECRET"
CRON_SECRET="change-this-to-a-random-string"
VERCEL_CRON_SECRET="set-this-in-vercel-project-settings"
# ============================================================

# ============================================================
# ELECTRON DESKTOP MODE (optional)
# ============================================================
# Path where the desktop app writes its runtime config JSON
# (firebaseServiceAccountBase64, appPin). When set, env vars (above)
# are ignored for those two fields and the values from this JSON file
# are used instead.
# SMARTCOMP_CONFIG_PATH="/path/to/config.json"
# ============================================================

# ============================================================
# PERFORMANCE TUNING (optional)
# ============================================================
# Reconcile delay (ms) — how long after a write to refresh the cache
# from Firestore in the background. Default 1200ms.
# SMARTCOMP_RECONCILE_DELAY_MS="1200"
