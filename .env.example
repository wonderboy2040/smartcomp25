# ============================================================
# FIREBASE (REQUIRED) — Backend database
# ============================================================
# The app uses Firebase Firestore as its database. Set ONE of:
#
# Option A (preferred): Base64-encoded service account JSON
#   1. Go to https://console.firebase.google.com → your project
#   2. Project Settings → Service accounts → Generate new private key
#   3. Download the JSON file
#   4. Base64-encode it:  base64 -w0 service-account.json
#   5. Paste the result below
#
# Option B: Individual fields
#   FIREBASE_PROJECT_ID="your-project-id"
#   FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
FIREBASE_SERVICE_ACCOUNT_BASE64=""

# ============================================================
# PIN PROTECTION (4-digit access lock)
# ============================================================
# Set a 4-digit (or up to 8-digit) numeric PIN to lock the entire panel
# behind a PIN entry screen. Leave empty/blank to disable (open access).
#
# When set, every visitor must enter this PIN at /login before they can
# view the dashboard or call any API. The PIN is never stored in the
# browser cookie - only a SHA-256 hash of (PIN + salt) is stored.
#
# Example:
APP_PIN="1234"
#
# To change the PIN later: update this env var and redeploy.
# To disable PIN protection: set APP_PIN="" (empty) or remove this line.
# ============================================================

# ============================================================
# WHATSAPP CLOUD API (auto-send + auto-capture replies)
# ============================================================
# Optional. If set, "Generate Messages" will send automatically from
# your business WhatsApp number and supplier replies will be captured
# via webhook. If NOT set, falls back to wa.me manual mode.
#
# Setup (see Settings → WhatsApp tab in the app, or README):
#   1. Create Meta Business account + WhatsApp app
#   2. Add a new phone number (NOT your personal WhatsApp number)
#   3. Get permanent access token + phone number ID
#   4. Create "rate_enquiry" message template, get it approved
#   5. Configure webhook URL: https://your-domain.com/api/whatsapp/webhook
#
# Required for auto-send:
WA_TOKEN=""
WA_PHONE_NUMBER_ID=""
WA_BUSINESS_NUMBER=""           # e.g. 919876543210 (E.164, no +)

# Required for webhook (incoming replies):
WA_VERIFY_TOKEN="smartcomp_wh_2026"   # any random string; same in Meta webhook config

# Optional (defaults to rate_enquiry):
WA_TEMPLATE_NAME="rate_enquiry"
# ============================================================

# ============================================================
# RAZORPAY (Online Payment Gateway)
# ============================================================
# Optional. If set, customers can pay invoices online via UPI/Card.
# Get these from https://dashboard.razorpay.com/app/keys
# If NOT set, invoices will generate UPI QR code (if UPI ID is set in Settings).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Webhook secret from https://dashboard.razorpay.com/app/webhooks
# Used to verify payment confirmation webhooks
RAZORPAY_WEBHOOK_SECRET=""

# Your app's public URL (for Razorpay callback + tracking links)
# Example: https://smartcomp-8m81.onrender.com
NEXT_PUBLIC_BASE_URL=""
# ============================================================

# Optional: Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED="1"

# ============================================================
# CRON SECRETS (auto-enquiry + AMC alerts)
# ============================================================
# On Vercel: Vercel auto-injects Authorization: Bearer ${VERCEL_CRON_SECRET}
#   when cron hits the path. Set VERCEL_CRON_SECRET in Vercel project settings.
# On Render / other hosts: set CRON_SECRET and add the header manually:
#   curl -X POST https://your-app.com/api/cron/auto-enquiry \
#        -H "Authorization: Bearer YOUR_SECRET"
# Either secret works — the route accepts either one.
CRON_SECRET="change-this-to-a-random-string"
VERCEL_CRON_SECRET="set-this-in-vercel-project-settings"
# ============================================================

# ============================================================
# WHATSAPP WEBHOOK HMAC (required in production for webhook)
# ============================================================
# Used by /api/whatsapp/webhook to verify incoming messages are from Meta.
# Get this from your Meta App → WhatsApp → Configuration → App Secret.
# Without this, the webhook rejects all incoming messages in production.
WA_APP_SECRET=""
# ============================================================

# ============================================================
# ELECTRON DESKTOP MODE (optional)
# ============================================================
# Path where the desktop app writes its runtime config JSON
# (firebaseServiceAccountBase64, appPin). When set, env vars (above) are ignored
# and the values from this JSON file are used instead.
# SMARTCOMP_CONFIG_PATH="/path/to/config.json"
# ============================================================